# PulseNode — environment template
# Run ./deploy.sh for an interactive setup, or copy this file to .env.local and fill in manually.

# ── Public URL ─────────────────────────────────────────────────────────────────
# Set this to your VPS IP or domain. Caddy routes internally.
NEXT_PUBLIC_ORIGIN=http://YOUR_VPS_IP
NEXT_PUBLIC_GO_API=http://YOUR_VPS_IP/go
CADDY_SITE_ADDRESS=:80

# ── Internal port bindings ─────────────────────────────────────────────────────
# Bound to localhost so only Caddy (or Traefik) can reach them from outside.
WEB_PORT=127.0.0.1:3000
GO_PORT=127.0.0.1:4002

# ── API security ───────────────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32
# Leave empty to have PulseNode generate and persist random values on first start.
# Never reuse the same value for both, and never change AES_KEY after first start
# (stored secrets would become unreadable).
JWT_SECRET=
AES_KEY=
MASTER_ENCRYPTION_KEY=

# The dashboard is locked until an admin account exists. Creating it requires this
# one-time token; if empty, one is generated and printed in `docker compose logs go-api`.
PULSENODE_SETUP_TOKEN=

# ── Optional: PostgreSQL introspection ─────────────────────────────────────────
# Enables real table sizes, row counts, and slow-query data in the Databases tab.
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=
