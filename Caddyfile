{
	admin localhost:2019
	servers {
		# Whose X-Forwarded-For to believe when resolving {client_ip}. Standalone,
		# Caddy is the edge, so nobody (loopback only). The Traefik overlay sets
		# private_ranges; narrow it to Traefik's own IP/CIDR if untrusted apps
		# share its network, or they can spoof their IP to the rate limiter.
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:127.0.0.1/32}
	}
}

{$CADDY_SITE_ADDRESS} {
	# go-api keys rate limits and the audit log on this; overwrite whatever the
	# client sent so it can't be spoofed.
	request_header X-Real-IP {client_ip}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Ignored by browsers on plain-HTTP responses. No includeSubDomains:
		# apps deployed on sibling subdomains may still be HTTP-only.
		Strict-Transport-Security "max-age=31536000"
		# 'unsafe-inline' scripts: Next.js 14 inlines its bootstrap scripts.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
		-X-Powered-By
	}

	# Compress everything except streaming endpoints
	@compressible not path /events /ws /api/ws/*
	encode @compressible gzip

	handle_path /go/* {
		reverse_proxy go-api:4002 {
			flush_interval -1
		}
	}

	handle /events {
		reverse_proxy go-api:4002 {
			flush_interval -1
		}
	}

	handle /ws {
		reverse_proxy go-api:4002
	}

	handle /health {
		reverse_proxy go-api:4002
	}

	handle {
		reverse_proxy web:3000
	}
}
